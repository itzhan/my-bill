# 监听端口
PORT=3000
# 数据目录（SQLite 文件与会话密钥存放处）
DATA_DIR=./data
# 会话签名密钥；留空则首次启动自动生成并保存在 DATA_DIR/session.secret
SESSION_SECRET=
# 部署在 nginx / caddy 等反向代理后面时保持为 1
TRUST_PROXY=1
# 报表按哪个时区分日
TIMEZONE=Asia/Shanghai

# AI 财务报表（Anthropic 兼容接口）。不填则 AI 功能关闭，其余功能不受影响
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-sonnet-5
# 数据变动后多久自动刷新最近看过的 AI 报表（毫秒）
AI_AUTO_DELAY_MS=45000

# 中转站（Sub2API）管理接口，可选：配置后 AI 助手能查客户消耗、余额、实时 RPM
RELAY_BASE_URL=
RELAY_ADMIN_KEY=
RELAY_NAME=中转站
